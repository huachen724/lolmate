{
  "name": "lolmate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Search League of Legends players, see their stats (via the Riot API), and read/leave peer reviews about what they're like to play with.",
  "scripts": {
    "client": "vite",
    "server": "node server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  }
}
