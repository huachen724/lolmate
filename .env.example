# Read by server.js (never the browser — see vite.config.ts's /api proxy).

RIOT_API_KEY=your-riot-api-key-here

# Platform routing value (summoner-v4, league-v4, spectator-v5 live data).
RIOT_PLATFORM=na1

# Regional routing value (account-v1, match-v5). Must correspond to the
# platform above (na1/br1/la1/la2/oc1 -> americas, euw1/eun1/ru/tr1 -> europe,
# kr/jp1 -> asia).
RIOT_REGION=americas

PORT=51791

# Postgres connection string — stores reviews/votes and accounts (see
# db.js). Player stats always come live from Riot, never cached here.
DATABASE_URL=postgres://user:password@localhost:5432/lolmate

# --- Login (Discord/Google OAuth) + session cookie -------------------------
# See auth.js. Each provider is independently optional — its "Continue with
# X" button only appears once both its client id and secret are set (see
# GET /api/status). Sign-in itself doesn't touch Riot's API; only
# afterwards, verifying you own a specific Riot account, does (see
# /api/verify/start and /api/verify/check).

# https://discord.com/developers/applications -> New Application -> OAuth2.
# Redirect URI to register there: ${BACKEND_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# https://console.cloud.google.com/ -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Redirect URI to register there:
# ${BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret used to sign the session cookie (HMAC-SHA256) — generate
# with `openssl rand -hex 32`. Required for any login to work; changing it
# invalidates every existing session.
SESSION_SECRET=

# This server's own public URL — used to build the OAuth redirect_uri
# values above. Defaults to http://localhost:$PORT, which is correct for
# local dev.
BACKEND_URL=http://localhost:51791

# The frontend's public URL — used for CORS (credentialed cross-origin
# requests need an explicit origin, not a wildcard) and as the redirect
# target once an OAuth login completes. Defaults to the Vite dev server.
FRONTEND_URL=http://localhost:5174

# Set to "production" on Render — switches the session cookie to
# SameSite=None; Secure, required once the frontend (Vercel) and backend
# (Render) are on different domains. Leave unset for local dev.
NODE_ENV=development
