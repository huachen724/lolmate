# Read by server.js (never the browser — see vite.config.ts's /api proxy).

RIOT_API_KEY=your-riot-api-key-here

# Platform routing value (summoner-v4, league-v4, spectator-v5 live data).
RIOT_PLATFORM=na1

# Regional routing value (account-v1, match-v5). Must correspond to the
# platform above (na1/br1/la1/la2/oc1 -> americas, euw1/eun1/ru/tr1 -> europe,
# kr/jp1 -> asia).
RIOT_REGION=americas

# Riot Sign On (RSO) OAuth credentials — not used yet. "Sign in with Riot
# Games" currently just prompts for your Riot ID and resolves it through
# the real API (see src/components/SignInModal), because RSO is a separate
# approval on top of a production API key (RSO Client Request Form), not
# something a dev/personal key unlocks. Fill these in once that's approved.
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_REDIRECT_URI=http://localhost:5174/auth/callback

PORT=51791
